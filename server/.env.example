# Your Supabase project's address, from Project Settings > API.
SUPABASE_URL=https://xxxx.supabase.co
# The secret key from Project Settings > API Keys: it starts sb_secret_ (on older projects it is the
# service_role key). Not the publishable or anon key. It can read and change every row, so it belongs
# only in this file on your own server: never in the app, in chat, or in the repository.
SUPABASE_SERVICE_KEY=
# Optional: an Odds API key, to save closing prices. About one credit per league each time a bet nears kick-off.
ODDS_API_KEY=
# Optional: the ntfy topic for phone messages.
NTFY_TOPIC=
# Optional: pounds staked in a calendar month before you are warned.
BETIQ_MONTHLY_LIMIT=
