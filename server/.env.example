# Your Supabase project's address, from Project Settings > API.
SUPABASE_URL=https://xxxx.supabase.co
# The secret key from Project Settings > API Keys: it starts sb_secret_ (on older projects it is the
# service_role key). Not the publishable or anon key. It can read and change every row, so it belongs
# only in this file on your own server: never in the app, in chat, or in the repository.
SUPABASE_SERVICE_KEY=
# Optional: an Odds API key, to save closing prices. About one credit per league each time a bet nears kick-off.
ODDS_API_KEY=
# Optional: the ntfy topic for phone messages.
NTFY_TOPIC=
# Optional: pounds staked in a calendar month before you are warned.
BETIQ_MONTHLY_LIMIT=

# ---- Price watcher (optional; start it with: docker compose --profile watcher up -d --build) ----
# It uses ODDS_API_KEY and NTFY_TOPIC from above. One refresh costs one credit per league.
# Leagues to watch, as Odds API keys. Default: soccer_epl,soccer_efl_champ
BETIQ_LEAGUES=
# Bookmakers you use, exactly as the page names them, separated by commas. Default: all of them.
BETIQ_BOOKS=
# How old prices may get, in hours, before they are loaded again. Default 6 (about 240 credits a month for two leagues).
BETIQ_WATCH_HOURS=
# Stop loading prices when fewer credits than this remain, to leave some for your phone. Default 150.
BETIQ_MIN_CREDITS=
# Set to 1 to also refresh a league shortly before its matches start. Costs more credits.
BETIQ_KICKOFF=
